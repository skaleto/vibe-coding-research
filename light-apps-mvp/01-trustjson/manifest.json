{
  "manifest_version": 3,
  "name": "TrustJSON — Local, Zero-Tracking JSON Viewer",
  "version": "0.1.0",
  "description": "100% local, zero-tracking, open-source JSON viewer. No network access, no ads, handles 50MB files without freezing.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Open TrustJSON viewer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*.json", "file:///*.json", "*://*/*.json?*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer.html"],
      "matches": ["*://*/*", "file:///*"]
    }
  ]
}
