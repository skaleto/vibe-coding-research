<?xml version="1.0" encoding="UTF-8"?>
<!--
  EchoKey Info.plist（供 Xcode 工程 INFOPLIST_FILE 使用）。

  说明：SwiftPM 可执行包不会自动把这个文件当作 app bundle 的 Info.plist 注入，
  权限说明字符串要在真机生效，请在 Xcode 工程里设置 INFOPLIST_FILE = Info.plist，
  或把下列键直接填到 target 的 Info 配置里。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>EchoKey</string>
    <key>CFBundleDisplayName</key>
    <string>EchoKey</string>
    <key>CFBundleIdentifier</key>
    <string>app.echokey.mac</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- 菜单栏 App：不在 Dock 显示主窗口、无主菜单栏，纯后台 + 状态项。 -->
    <key>LSUIElement</key>
    <true/>

    <!-- 麦克风权限说明（中文，会显示在系统授权弹窗里）。 -->
    <key>NSMicrophoneUsageDescription</key>
    <string>EchoKey 需要使用麦克风来录制你的语音并在本机转写成文字。音频全程只在你的 Mac 上处理，不会上传任何服务器。</string>

    <!-- 语音识别权限说明（用 Apple 端侧 SFSpeechRecognizer 降级路径时需要）。 -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>EchoKey 使用语音识别把你的语音转写成文字。默认在本机端侧完成，开启「仅本机识别」后不会联网。</string>
</dict>
</plist>
