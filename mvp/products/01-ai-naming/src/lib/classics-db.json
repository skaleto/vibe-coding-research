  "entries": [
    {
      "book": "诗经",
      "chapter": "小雅·节南山",
      "verses": [
        "节彼南山，维石岩岩",
        "赫赫师尹，民具尔瞻",
        "忧心如惔，不敢戏谈",
        "国既卒斩，何用不监",
        "节彼南山，有实其猗",
        "赫赫师尹，不平谓何",
        "天方荐瘥，丧乱弘多",
        "民言无嘉，憯莫惩嗟",
        "尹氏大师，维周之氐",
        "秉国之均，四方是维",
        "天子是毗，俾民不迷",
        "弗躬弗亲，庶民弗信",
        "弗问弗仕，勿罔君子",
        "知微知章，唯思唯念",
        "君子作歌，维以告哀"
      ]
    },
    {
      "book": "诗经",
      "chapter": "周南·关雎",
      "verses": [
        "关关雎鸠，在河之洲",
        "窈窕淑女，君子好逑",
        "参差荇菜，左右流之",
        "窈窕淑女，寤寐求之",
        "求之不得，寤寐思服",
        "悠哉悠哉，辗转反侧",
        "参差荇菜，左右采之",
        "窈窕淑女，琴瑟友之",
        "参差荇菜，左右芼之",
        "窈窕淑女，钟鼓乐之"
      ]
    },
    {
      "book": "诗经",
      "chapter": "周南·桃夭",
      "verses": [
        "桃之夭夭，灼灼其华",
        "之子于归，宜其室家",
        "桃之夭夭，有蕡其实",
        "之子于归，宜其家室",
        "桃之夭夭，其叶蓁蓁",
        "之子于归，宜其家人"
      ]
    },
    {
      "book": "诗经",
      "chapter": "周南·葛覃",
      "verses": [
        "葛之覃兮，施于中谷",
        "维叶萋萋，黄鸟于飞",
        "集于灌木，其鸣喈喈"
      ]
    },
    {
      "book": "诗经",
      "chapter": "周南·卷耳",
      "verses": [
        "采采卷耳，不盈顷筐",
        "嗟我怀人，寘彼周行"
      ]
    },
    {
      "book": "诗经",
      "chapter": "召南·鹊巢",
      "verses": [
        "维鹊有巢，维鸠居之",
        "之子于归，百两御之"
      ]
    },
    {
      "book": "诗经",
      "chapter": "召南·采蘩",
      "verses": [
        "于以采蘩，于沼于沚",
        "于以用之，公侯之事"
      ]
    },
    {
      "book": "诗经",
      "chapter": "邶风·静女",
      "verses": [
        "静女其姝，俟我于城隅",
        "爱而不见，搔首踟蹰",
        "静女其娈，贻我彤管",
        "彤管有炜，说怿女美",
        "自牧归荑，洵美且异",
        "匪女之为美，美人之贻"
      ]
    },
    {
      "book": "诗经",
      "chapter": "邶风·凯风",
      "verses": [
        "凯风自南，吹彼棘心",
        "棘心夭夭，母氏劬劳"
      ]
    },
    {
      "book": "诗经",
      "chapter": "鄘风·柏舟",
      "verses": [
        "泛彼柏舟，在彼中河",
        "髧彼两髦，实维我仪"
      ]
    },
    {
      "book": "诗经",
      "chapter": "卫风·硕人",
      "verses": [
        "硕人其颀，衣锦褧衣",
        "手如柔荑，肤如凝脂",
        "领如蝤蛴，齿如瓠犀",
        "螓首蛾眉，巧笑倩兮，美目盼兮"
      ]
    },
    {
      "book": "诗经",
      "chapter": "卫风·淇奥",
      "verses": [
        "瞻彼淇奥，绿竹猗猗",
        "有匪君子，如切如磋，如琢如磨",
        "瑟兮僩兮，赫兮咺兮",
        "有匪君子，终不可谖兮"
      ]
    },
    {
      "book": "诗经",
      "chapter": "王风·君子于役",
      "verses": [
        "君子于役，不知其期",
        "曷至哉，鸡栖于埘"
      ]
    },
    {
      "book": "诗经",
      "chapter": "郑风·野有蔓草",
      "verses": [
        "野有蔓草，零露漙兮",
        "有美一人，清扬婉兮",
        "邂逅相遇，适我愿兮"
      ]
    },
    {
      "book": "诗经",
      "chapter": "郑风·子衿",
      "verses": [
        "青青子衿，悠悠我心",
        "纵我不往，子宁不嗣音"
      ]
    },
    {
      "book": "诗经",
      "chapter": "齐风·甫田",
      "verses": [
        "无田甫田，维莠骄骄",
        "无思远人，劳心忉忉"
      ]
    },
    {
      "book": "诗经",
      "chapter": "魏风·硕鼠",
      "verses": [
        "硕鼠硕鼠，无食我黍",
        "三岁贯女，莫我肯顾"
      ]
    },
    {
      "book": "诗经",
      "chapter": "唐风·绸缪",
      "verses": [
        "绸缪束薪，三星在天",
        "今夕何夕，见此良人"
      ]
    },
    {
      "book": "诗经",
      "chapter": "秦风·蒹葭",
      "verses": [
        "蒹葭苍苍，白露为霜",
        "所谓伊人，在水一方",
        "溯洄从之，道阻且长",
        "溯游从之，宛在水中央",
        "蒹葭萋萋，白露未晞",
        "所谓伊人，在水之湄"
      ]
    },
    {
      "book": "诗经",
      "chapter": "陈风·月出",
      "verses": [
        "月出皎兮，佼人僚兮",
        "舒窈纠兮，劳心悄兮"
      ]
    },
    {
      "book": "诗经",
      "chapter": "小雅·鹿鸣",
      "verses": [
        "呦呦鹿鸣，食野之苹",
        "我有嘉宾，鼓瑟吹笙",
        "吹笙鼓簧，承筐是将",
        "人之好我，示我周行"
      ]
    },
    {
      "book": "诗经",
      "chapter": "小雅·常棣",
      "verses": [
        "常棣之华，鄂不韡韡",
        "凡今之人，莫如兄弟"
      ]
    },
    {
      "book": "诗经",
      "chapter": "小雅·伐木",
      "verses": [
        "伐木丁丁，鸟鸣嘤嘤",
        "出自幽谷，迁于乔木"
      ]
    },
    {
      "book": "诗经",
      "chapter": "小雅·采薇",
      "verses": [
        "采薇采薇，薇亦作止",
        "曰归曰归，岁亦莫止",
        "昔我往矣，杨柳依依",
        "今我来思，雨雪霏霏",
        "行道迟迟，载渴载饥",
        "我心伤悲，莫知我哀"
      ]
    },
    {
      "book": "诗经",
      "chapter": "小雅·庭燎",
      "verses": [
        "夜如何其，夜未央",
        "庭燎之光，君子至止",
        "鸾声将将，夜如何其",
        "夜未艾，庭燎晣晣"
      ]
    },
    {
      "book": "诗经",
      "chapter": "小雅·黍苗",
      "verses": [
        "芃芃黍苗，阴雨膏之",
        "悠悠南行，召伯劳之"
      ]
    },
    {
      "book": "诗经",
      "chapter": "小雅·斯干",
      "verses": [
        "秩秩斯干，幽幽南山",
        "如竹苞矣，如松茂矣",
        "兄及弟矣，式相好矣，无相犹矣"
      ]
    },
    {
      "book": "诗经",
      "chapter": "小雅·鹤鸣",
      "verses": [
        "鹤鸣于九皋，声闻于野",
        "鱼潜在渊，或在于渚",
        "他山之石，可以为错"
      ]
    },
    {
      "book": "诗经",
      "chapter": "大雅·思齐",
      "verses": [
        "思齐大任，文王之母",
        "思媚周姜，京室之妇",
        "大姒嗣徽音，则百斯男",
        "惠于宗公，神罔时怨"
      ]
    },
    {
      "book": "诗经",
      "chapter": "大雅·文王",
      "verses": [
        "文王在上，于昭于天",
        "周虽旧邦，其命维新",
        "穆穆文王，于缉熙敬止"
      ]
    },
    {
      "book": "诗经",
      "chapter": "大雅·烝民",
      "verses": [
        "天生烝民，有物有则",
        "民之秉彝，好是懿德"
      ]
    },
    {
      "book": "诗经",
      "chapter": "颂·清庙",
      "verses": [
        "於穆清庙，肃雍显相",
        "济济多士，秉文之德"
      ]
    },
    {
      "book": "楚辞",
      "chapter": "离骚",
      "verses": [
        "帝高阳之苗裔兮，朕皇考曰伯庸",
        "摄提贞于孟陬兮，惟庚寅吾以降",
        "皇览揆余初度兮，肇锡余以嘉名",
        "名余曰正则兮，字余曰灵均",
        "纷吾既有此内美兮，又重之以修能",
        "扈江离与辟芷兮，纫秋兰以为佩",
        "汩余若将不及兮，恐年岁之不吾与",
        "朝搴阰之木兰兮，夕揽洲之宿莽",
        "日月忽其不淹兮，春与秋其代序",
        "惟草木之零落兮，恐美人之迟暮",
        "路漫漫其修远兮，吾将上下而求索",
        "亦余心之所善兮，虽九死其犹未悔",
        "长太息以掩涕兮，哀民生之多艰",
        "余固知謇謇之为患兮，忍而不能舍也",
        "民生各有所乐兮，余独好修以为常"
      ]
    },
    {
      "book": "楚辞",
      "chapter": "九歌·云中君",
      "verses": [
        "浴兰汤兮沐芳，华采衣兮若英",
        "灵连蜷兮既留，烂昭昭兮未央",
        "蹇将憺兮寿宫，与日月兮齐光"
      ]
    },
    {
      "book": "楚辞",
      "chapter": "九歌·湘君",
      "verses": [
        "君不行兮夷犹，蹇谁留兮中洲",
        "美要眇兮宜修，沛吾乘兮桂舟",
        "驾飞龙兮北征，邅吾道兮洞庭"
      ]
    },
    {
      "book": "楚辞",
      "chapter": "九章·涉江",
      "verses": [
        "余幼好此奇服兮，年既老而不衰",
        "带长铗之陆离兮，冠切云之崔嵬",
        "被明月兮佩宝璐，世溷浊而莫余知兮",
        "驾青虬兮骖白螭，吾与重华游兮瑶之圃",
        "登昆仑兮食玉英，与天地兮同寿"
      ]
    },
    {
      "book": "楚辞",
      "chapter": "九章·橘颂",
      "verses": [
        "后皇嘉树，橘徕服兮",
        "受命不迁，生南国兮",
        "深固难徙，更壹志兮",
        "绿叶素荣，纷其可喜兮",
        "嗟尔幼志，有以异兮",
        "独立不迁，岂不可喜兮",
        "苏世独立，横而不流兮"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "李白·静夜思",
      "verses": [
        "床前明月光，疑是地上霜",
        "举头望明月，低头思故乡"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "李白·望庐山瀑布",
      "verses": [
        "日照香炉生紫烟，遥看瀑布挂前川",
        "飞流直下三千尺，疑是银河落九天"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "李白·将进酒",
      "verses": [
        "君不见黄河之水天上来，奔流到海不复回",
        "君不见高堂明镜悲白发，朝如青丝暮成雪",
        "人生得意须尽欢，莫使金樽空对月",
        "天生我材必有用，千金散尽还复来"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "杜甫·春望",
      "verses": [
        "国破山河在，城春草木深",
        "感时花溅泪，恨别鸟惊心",
        "烽火连三月，家书抵万金"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "杜甫·登高",
      "verses": [
        "风急天高猿啸哀，渚清沙白鸟飞回",
        "无边落木萧萧下，不尽长江滚滚来"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "杜甫·望岳",
      "verses": [
        "岱宗夫如何，齐鲁青未了",
        "造化钟神秀，阴阳割昏晓",
        "荡胸生层云，决眦入归鸟",
        "会当凌绝顶，一览众山小"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "王维·山居秋暝",
      "verses": [
        "空山新雨后，天气晚来秋",
        "明月松间照，清泉石上流",
        "竹喧归浣女，莲动下渔舟",
        "随意春芳歇，王孙自可留"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "王维·送元二使安西",
      "verses": [
        "渭城朝雨浥轻尘，客舍青青柳色新",
        "劝君更尽一杯酒，西出阳关无故人"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "王维·相思",
      "verses": [
        "红豆生南国，春来发几枝",
        "愿君多采撷，此物最相思"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "孟浩然·春晓",
      "verses": [
        "春眠不觉晓，处处闻啼鸟",
        "夜来风雨声，花落知多少"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "孟浩然·过故人庄",
      "verses": [
        "故人具鸡黍，邀我至田家",
        "绿树村边合，青山郭外斜"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "白居易·赋得古原草送别",
      "verses": [
        "离离原上草，一岁一枯荣",
        "野火烧不尽，春风吹又生",
        "远芳侵古道，晴翠接荒城"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "白居易·钱塘湖春行",
      "verses": [
        "孤山寺北贾亭西，水面初平云脚低",
        "几处早莺争暖树，谁家新燕啄春泥",
        "乱花渐欲迷人眼，浅草才能没马蹄"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "刘禹锡·陋室铭",
      "verses": [
        "山不在高，有仙则名",
        "水不在深，有龙则灵",
        "斯是陋室，惟吾德馨"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "王勃·送杜少府之任蜀州",
      "verses": [
        "城阙辅三秦，风烟望五津",
        "与君离别意，同是宦游人",
        "海内存知己，天涯若比邻",
        "无为在歧路，儿女共沾巾"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "王之涣·登鹳雀楼",
      "verses": [
        "白日依山尽，黄河入海流",
        "欲穷千里目，更上一层楼"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "贺知章·咏柳",
      "verses": [
        "碧玉妆成一树高，万条垂下绿丝绦",
        "不知细叶谁裁出，二月春风似剪刀"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "李商隐·锦瑟",
      "verses": [
        "锦瑟无端五十弦，一弦一柱思华年",
        "庄生晓梦迷蝴蝶，望帝春心托杜鹃",
        "沧海月明珠有泪，蓝田日暖玉生烟",
        "此情可待成追忆，只是当时已惘然"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "李商隐·夜雨寄北",
      "verses": [
        "君问归期未有期，巴山夜雨涨秋池",
        "何当共剪西窗烛，却话巴山夜雨时"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "韦应物·咏露珠",
      "verses": [
        "秋荷一滴露，清夜坠玄天",
        "将来玉盘上，不定始知圆"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "韦应物·滁州西涧",
      "verses": [
        "独怜幽草涧边生，上有黄鹂深树鸣",
        "春潮带雨晚来急，野渡无人舟自横"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "杜牧·山行",
      "verses": [
        "远上寒山石径斜，白云生处有人家",
        "停车坐爱枫林晚，霜叶红于二月花"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "张若虚·春江花月夜",
      "verses": [
        "春江潮水连海平，海上明月共潮生",
        "滟滟随波千万里，何处春江无月明",
        "江畔何人初见月，江月何年初照人",
        "人生代代无穷已，江月年年只相似"
      ]
    },
    {
      "book": "唐诗",
      "chapter": "贾岛·寻隐者不遇",
      "verses": [
        "松下问童子，言师采药去",
        "只在此山中，云深不知处"
      ]
    },
